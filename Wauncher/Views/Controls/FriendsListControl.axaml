<UserControl
    x:Class="Wauncher.Views.Controls.FriendsListControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wauncher.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="260"
    d:DesignHeight="400"
    x:DataType="vm:MainWindowViewModel">

    <Grid Background="Transparent">
        <!-- Loading / error state -->
        <StackPanel
            IsVisible="{Binding ShowGenericFriendsStatus}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Margin="16,0">
            <TextBlock
                FontSize="12"
                FontStyle="Italic"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="200"
                Foreground="{DynamicResource AppMutedText}"
                Text="{Binding FriendsStatus}" />
        </StackPanel>

        <!-- No CC friends state -->
        <Grid IsVisible="{Binding ShowNoFriendsState}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6">
                <TextBlock
                    FontSize="36"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AppMutedText}"
                    Text=":(" />
                <TextBlock
                    FontSize="13"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AppPrimaryText}"
                    Text="No friends online" />
                <TextBlock
                    FontSize="11"
                    FontStyle="Italic"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AppMutedText}"
                    Text="Play matches to add friends." />
            </StackPanel>
        </Grid>

        <!-- Friends list -->
        <ScrollViewer
            IsVisible="{Binding !FriendsShowStatus}"
            Padding="6,6"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">
                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="36,*,12" Margin="2,1">
                                <Button Grid.Column="0" Grid.ColumnSpan="3" Classes="friendRowBtn" CornerRadius="6" MinHeight="42">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Top">
                                            <MenuItem Classes="compactFlyoutItem" Header="Join Server"
                                                      Click="JoinFriendServer_Click"
                                                      Tag="{Binding}"
                                                      IsVisible="{Binding CanQuickJoin}" />
                                            <MenuItem Classes="compactFlyoutItem" Header="View Profile"
                                                      Click="ViewFriendProfile_Click"
                                                      Tag="{Binding}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Grid ColumnDefinitions="34,*,14" VerticalAlignment="Center" Margin="6,2">
                                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Center" Opacity="{Binding AvatarOpacity}">
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AppPrimaryText}"
                                                Text="{Binding Username}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource AppMutedText}"
                                                Text="{Binding StatusText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding DotColor}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>