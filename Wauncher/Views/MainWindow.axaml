<Window
    x:Class="Wauncher.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svg="clr-namespace:Avalonia.Svg.Controls;assembly=Avalonia.Svg.Skia"
    xmlns:vm="using:Wauncher.ViewModels"
    xmlns:controls="using:Wauncher.Views.Controls"
    xmlns:conv="using:Wauncher.Converters"

    Title="ClassicCounter Wauncher"
    Width="1120"
    Height="660"
    MinWidth="940"
    MinHeight="540"
    CanResize="True"
    d:DesignHeight="660"
    d:DesignWidth="1120"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/Wauncher.ico"
    SystemDecorations="None"
    TransparencyLevelHint="AcrylicBlur"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    mc:Ignorable="d">

    <Window.Styles>
        <!-- Title Buttons -->
        <Style Selector="Button.titleBtn">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtn:pointerover">
            <Setter Property="Background" Value="#44FFFFFF" />
        </Style>
        <Style Selector="Button.titleBtn:pressed">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>

        <Style Selector="Button.closeBtn">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.closeBtn:pointerover">
            <Setter Property="Background" Value="#CCE53935" />
        </Style>
        <Style Selector="Button.closeBtn:pressed">
            <Setter Property="Background" Value="#FFB71C1C" />
        </Style>

        <!-- Icon Buttons -->
        <Style Selector="Button.iconBtn">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AppIconBtnBg}" />
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="12" Color="#00C8FF" OffsetX="0" OffsetY="0" Opacity="0.35" />
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource AppIconBtnBorder}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.iconBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppIconBtnHover}" />
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="20" Color="#00C8FF" OffsetX="0" OffsetY="0" Opacity="0.85" />
            </Setter>
        </Style>
        <Style Selector="Button.iconBtn:pressed">
            <Setter Property="Background" Value="{DynamicResource AppIconBtnPressed}" />
        </Style>

        <!-- Launch Button -->
        <Style Selector="Button.launchBtn">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AppAccentGreen}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.18" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.launchBtn:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#44FFFFFF" />
        </Style>
        <Style Selector="Button.launchBtn:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.launchBtn.updating">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.launchBtn.installPending">
            <Setter Property="Background" Value="#2196F3" />
        </Style>
        <Style Selector="Button.launchBtn.updatePending">
            <Setter Property="Background" Value="#FFC107" />
        </Style>

        <!-- Server List Buttons -->
        <Style Selector="Button.serverBtn">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.serverBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppServerHover}" />
        </Style>
        <Style Selector="Button.serverBtn:pressed">
            <Setter Property="Background" Value="{DynamicResource AppServerPressed}" />
        </Style>

        <Style Selector="Button.friendRowBtn">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.friendRowBtn:pointerover">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>

        <Style Selector="TextBlock.selectedlabel">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedText}" />
        </Style>
        <Style Selector="TextBlock.selectedlabel.noserver">
            <Setter Property="Foreground" Value="#F44336" />
        </Style>
        <Style Selector="TextBlock.selectedlabel.serverselected">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentGreen}" />
        </Style>
    </Window.Styles>

    <Grid Background="{DynamicResource AppMainBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── TITLE BAR ── -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource AppTitleBarBrush}" PointerPressed="TitleBar_PointerPressed">
            <Border x:Name="TitleLineGlow" VerticalAlignment="Bottom" Height="1" HorizontalAlignment="Stretch" Background="{DynamicResource AppAccentGreen}" Opacity="0.35" BoxShadow="{DynamicResource AppTitleLineBoxShadow}" />
            
            <!-- App Logo & Name -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0">
                <Image Height="20" Source="avares://Wauncher/Assets/logo.png" />
                <TextBlock Text="CLASSIC COUNTER LAUNCHER" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" Foreground="{DynamicResource AppPrimaryText}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Window Controls -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Stretch" Orientation="Horizontal" Spacing="0">
                <Button x:Name="MinimizeButton" Classes="titleBtn" Width="46" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="MinimizeButton_Click">
                    <Path Width="10" Height="2" Data="M0,1 L10,1" Stroke="White" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="MaximizeButton" Classes="titleBtn" Width="46" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="MaximizeButton_Click">
                    <Path Width="10" Height="10" Data="M1,1 L9,1 L9,9 L1,9 Z" Stroke="White" StrokeThickness="1.2" />
                </Button>
                <Button x:Name="CloseButton" Classes="closeBtn" Width="46" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="CloseButton_Click">
                    <Path Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── MAIN BODY: 2 COLUMNS (TLauncher Schema) ── -->
        <Grid Grid.Row="1" Margin="14,12,14,10" ColumnDefinitions="*,260">

            <!-- ── LEFT MAIN AREA (TLauncher Left Big Area) ── -->
            <Grid Grid.Column="0" Margin="0,0,12,0" RowDefinitions="180,10,*">
                
                <!-- 1. Top Central Block: Server Selector (like TLauncher recommended servers) -->
                <controls:ServerListControl Grid.Row="0" x:Name="ServerListControl" />

                <!-- Separator / Margin -->
                <Rectangle Grid.Row="1" Fill="Transparent" />

                <!-- 2. Central Big Block: Patch Notes & News (like TLauncher update news) -->
                <controls:PatchNotesControl Grid.Row="2" x:Name="PatchNotesControl" />
            </Grid>

            <!-- ── RIGHT VERTICAL COLUMN (TLauncher Right Sidebar) ── -->
            <Border Grid.Column="1" Background="#14000000" BorderBrush="{DynamicResource AppDivider}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid RowDefinitions="34,1,*,1,Auto">
                    <!-- Sidebar Header: Friends -->
                    <Border Grid.Row="0" Background="#20FFFFFF" Padding="12,0">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AppAccentGreen}"
                                      Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                                <TextBlock Text="{DynamicResource Loc_FriendsTitle}" FontSize="11" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource AppPrimaryText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_FriendsOnline}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentGreen}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Rectangle Grid.Row="1" Fill="{DynamicResource AppDivider}" />

                    <!-- Friends List View -->
                    <controls:FriendsListControl Grid.Row="2" x:Name="FriendsListControl" />

                    <Rectangle Grid.Row="3" Fill="{DynamicResource AppDivider}" />

                    <!-- Sidebar Bottom: Customization Button (TLauncher helper buttons style) -->
                    <Border Grid.Row="4" Background="#18FFFFFF" Padding="12,10">
                        <Button Classes="serverBtn" HorizontalAlignment="Stretch" Padding="10,8" Click="OpenCustomization_Click">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                <Border x:Name="CustomizationBtnIconBorder" Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppAccentGreen}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M7,14c-1.66,0-3,1.34-3,3c0,1.31-1.16,2-2,2c0.92,1.22,2.49,2,4,2c2.21,0,4-1.79,4-4C10,15.34,8.66,14,7,14z M20.71,4.63l-1.34-1.34c-0.39-0.39-1.02-0.39-1.41,0L9,12.25L11.75,15l8.96-8.96C21.1,5.65,21.1,5.02,20.71,4.63z" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{DynamicResource Loc_CustomizationTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryText}" />
                                    <TextBlock Text="{DynamicResource Loc_CustomizationSub}" FontSize="10" Foreground="{DynamicResource AppMutedText}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── BOTTOM CONTROL BAR (TLauncher Launch Footer) ── -->
        <controls:UpdateBarControl Grid.Row="2" x:Name="UpdateBarControl" />

        <!-- ── MODAL OVERLAYS (Appearance, Settings, Info) ── -->
        <!-- Appearance Overlay -->
        <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsAppearancePanelOpen}" Background="#E0060A12" ZIndex="200" Padding="40">
            <Border Background="{DynamicResource AppMainBackground}" BorderBrush="{DynamicResource AppDivider2}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" MaxWidth="760" MaxHeight="520">
                <controls:AppearancePanel x:Name="AppearancePanelControl" />
            </Border>
        </Border>

        <!-- Settings Overlay -->
        <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsSettingsPanelOpen}" Background="#E0060A12" ZIndex="200" Padding="40">
            <Border Background="{DynamicResource AppMainBackground}" BorderBrush="{DynamicResource AppDivider2}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" MaxWidth="760" MaxHeight="520">
                <controls:SettingsPanel x:Name="SettingsPanelControl" />
            </Border>
        </Border>

        <!-- Info Overlay -->
        <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsInfoPanelOpen}" Background="#E0060A12" ZIndex="200" Padding="40">
            <Border Background="{DynamicResource AppMainBackground}" BorderBrush="{DynamicResource AppDivider2}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" MaxWidth="760" MaxHeight="520">
                <controls:InfoPanel x:Name="InfoPanelControl" />
            </Border>
        </Border>

    </Grid>
</Window>